NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://user:password@db.example.invalid:5432/ai_codeguard
REDIS_URL=rediss://user:password@redis.example.invalid:6379

JWT_SECRET=generate-a-unique-random-secret-at-least-32-characters
JWT_EXPIRY=7d
GITHUB_TOKEN_ENCRYPTION_KEY=generate-an-independent-random-key-at-least-32-characters
GITHUB_TOKEN_ENCRYPTION_KEY_PREVIOUS=

OPENAI_API_KEY=your-openai-api-key
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_CALLBACK_URL=https://api.example.invalid/api/auth/github/callback

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-stripe-pro-price-id
STRIPE_API_VERSION=2023-10-16

MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=noreply@example.invalid

FRONTEND_URL=https://app.example.invalid
