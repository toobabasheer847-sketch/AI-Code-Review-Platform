// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  fullName            String
  passwordHash        String
  workMemoryEnabled   Boolean              @default(true)
  avatar              String?
  githubId            String?              @unique
  githubAccount       GitHubAccount?
  isVerified          Boolean              @default(false)
  tokenVersion        Int                  @default(0)
  subscription        Subscription?
  repositories        Repository[]
  reviews             CodeReview[]
  chatConversations   ChatConversation[]
  usages              Usage[]
  reviewAnalytics     ReviewAnalytics[]
  accountTokens       AccountToken[]
  automations         Automation[]
  automationApprovals AutomationApproval[]
  socialAccounts      SocialAccount[]
  socialPosts         SocialPost[]
  socialPostEvents    SocialPostEvent[]
  workMemories        WorkMemory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([email])
}

enum AutomationMode {
  DRAFT_ONLY
  APPROVAL_REQUIRED
  AUTO_LOW_RISK
}

enum AutomationStatus {
  DRAFT
  AWAITING_APPROVAL
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  REJECTED
}

enum AutomationTaskStatus {
  PENDING
  AWAITING_APPROVAL
  READY
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum AutomationAttemptStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum AutomationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELED
}

model Automation {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           String
  title          String
  mode           AutomationMode       @default(APPROVAL_REQUIRED)
  status         AutomationStatus     @default(DRAFT)
  retryCount     Int                  @default(0)
  idempotencyKey String?
  tasks          AutomationTask[]
  events         AutomationEvent[]
  approvals      AutomationApproval[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model AutomationApproval {
  id           String                   @id @default(cuid())
  automationId String
  automation   Automation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       AutomationApprovalStatus @default(PENDING)
  summary      String
  payload      Json
  payloadHash  String
  expiresAt    DateTime
  decidedAt    DateTime?
  createdAt    DateTime                 @default(now())

  @@index([userId, status, expiresAt])
  @@index([automationId, status])
}

model AutomationTask {
  id                String                       @id @default(cuid())
  automationId      String
  automation        Automation                   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  key               String
  title             String
  description       String
  action            String
  dependencies      String[]                     @default([])
  input             Json
  output            Json?
  executionAttempts AutomationExecutionAttempt[]
  status            AutomationTaskStatus         @default(PENDING)
  attempts          Int                          @default(0)
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([automationId, key])
  @@index([automationId, status])
}

model AutomationExecutionAttempt {
  id            String                  @id @default(cuid())
  taskId        String
  task          AutomationTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        AutomationAttemptStatus @default(RUNNING)
  output        Json?
  errorMessage  String?
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  createdAt     DateTime                @default(now())

  @@unique([taskId, attemptNumber])
  @@index([taskId, createdAt])
}

model AutomationEvent {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type         String
  message      String
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
}

model GitHubAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId    String   @unique
  username    String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SocialProvider {
  LINKEDIN
}

enum SocialPostStatus {
  DRAFT
  AWAITING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  PUBLICATION_UNKNOWN
  CANCELED
  REJECTED
}

model SocialAccount {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          SocialProvider
  providerAccountId String
  displayName       String
  accessToken       String
  scopes            String[]
  tokenExpiresAt    DateTime
  posts             SocialPost[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider])
}

model SocialPost {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String?
  account              SocialAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  platform             SocialProvider
  platformAccountId    String
  destinationLabel     String
  content              String
  instructions         String?
  evidenceReviewId     String?
  evidenceUrl          String?
  status               SocialPostStatus @default(DRAFT)
  scheduledAt          DateTime?
  nextAttemptAt        DateTime?
  approvalHash         String?
  approvalExpiresAt    DateTime?
  approvedAt           DateTime?
  approvedBy           String?
  scheduleVersion      Int              @default(0)
  attemptCount         Int              @default(0)
  retryable            Boolean          @default(false)
  providerPostId       String?
  providerUrl          String?
  errorCode            String?
  errorMessage         String?
  idempotencyKey       String?
  publishedAt          DateTime?
  events               SocialPostEvent[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([accountId])
}

model SocialPostEvent {
  id        String     @id @default(cuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  details   Json?
  createdAt DateTime   @default(now())

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  type      AccountTokenType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                     Plan               @default(FREE)
  status                   SubscriptionStatus @default(ACTIVE)
  stripeId                 String?            @unique
  priceId                  String?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelledAt              DateTime?
  lastStripeEventCreatedAt DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model StripeEvent {
  id           String   @id
  type         String
  status       String   @default("PROCESSED")
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, updatedAt])
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Usage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewCount Int      @default(0)
  month       Int
  year        Int
  createdAt   DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
}

model Repository {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  url         String
  language    String?
  description String?
  isPrivate   Boolean      @default(false)
  reviews     CodeReview[]
  workMemories WorkMemory[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, url])
  @@index([userId])
}

enum WorkMemoryType {
  PROJECT_SUMMARY
  TECHNICAL_DECISION
  PREFERENCE
  WORKFLOW_OUTCOME
  LESSON
  INTEGRATION_REFERENCE
  PROJECT_CONTEXT
}

enum WorkMemorySource {
  USER_PROVIDED
  APPROVED_WORKFLOW
  AI_GENERATED
  INFERENCE
}

model WorkMemory {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId String?
  repository  Repository?     @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  type        WorkMemoryType
  source      WorkMemorySource
  sourceLabel String
  sourceId    String?
  content     String
  confidence  Float?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([repositoryId])
}

enum ReviewSource {
  MANUAL
  PULL_REQUEST
}

model CodeReview {
  id                String                  @id @default(cuid())
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId      String
  repository        Repository              @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  fileContent       String
  branch            String                  @default("main")
  source            ReviewSource            @default(MANUAL)
  pullRequestNumber Int?
  pullRequestUrl    String?
  headSha           String?
  changedLines      Json?
  reviewLimitations String[]                @default([])
  errorMessage      String?
  severity          String                  @default("medium")
  status            String                  @default("pending")
  findings          Finding[]
  chatConversation  ChatConversation?
  analytics         ReviewAnalytics?
  webhookDeliveries GitHubWebhookDelivery[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([repositoryId, pullRequestNumber, headSha])
  @@index([userId])
  @@index([repositoryId])
  @@index([status])
}

model GitHubWebhookDelivery {
  id                 String      @id
  event              String
  action             String
  repositoryFullName String
  pullRequestNumber  Int
  headSha            String
  status             String      @default("processing")
  errorMessage       String?
  reviewId           String?
  review             CodeReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([reviewId])
}

model Finding {
  id          String     @id @default(cuid())
  reviewId    String
  review      CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file        String
  line        Int
  endLine     Int?
  title       String?
  message     String
  evidence    String?
  severity    String
  category    String     @default("quality")
  suggestions String[]
  createdAt   DateTime   @default(now())

  @@index([reviewId])
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId  String        @unique
  review    CodeReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([reviewId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ReviewAnalytics {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId          String
  review            CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  totalIssues       Int
  bugs              Int
  securityIssues    Int
  performanceIssues Int
  qualityScore      Int
  createdAt         DateTime   @default(now())

  @@unique([reviewId])
  @@index([userId])
  @@index([reviewId])
}
