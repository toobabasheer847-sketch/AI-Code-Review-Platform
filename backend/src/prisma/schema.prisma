// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  fullName      String
  passwordHash  String
  avatar        String?
  githubId      String?         @unique
  githubAccount GitHubAccount?
  isVerified    Boolean         @default(false)
  tokenVersion  Int             @default(0)
  subscription  Subscription?
  repositories  Repository[]
  reviews       CodeReview[]
  chatConversations ChatConversation[]
  usages         Usage[]
  reviewAnalytics ReviewAnalytics[]
  accountTokens AccountToken[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
}

model GitHubAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId    String   @unique
  username    String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AccountTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  type      AccountTokenType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan      @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  stripeId      String?   @unique
  priceId       String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelledAt   DateTime?
  lastStripeEventCreatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Usage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewCount Int     @default(0)
  month      Int
  year       Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@unique([userId, month, year])
}

model Repository {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  language      String?
  description   String?
  isPrivate     Boolean   @default(false)
  reviews       CodeReview[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@unique([userId, url])
}

enum ReviewSource {
  MANUAL
  PULL_REQUEST
}

model CodeReview {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositoryId  String
  repository    Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  fileContent   String
  branch        String          @default("main")
  source        ReviewSource    @default(MANUAL)
  pullRequestNumber Int?
  pullRequestUrl String?
  headSha       String?
  changedLines  Json?
  reviewLimitations String[]     @default([])
  errorMessage  String?
  severity      String          @default("medium")
  status        String          @default("pending")
  findings      Finding[]
  chatConversation ChatConversation?
  analytics     ReviewAnalytics?
  webhookDeliveries GitHubWebhookDelivery[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([repositoryId])
  @@index([status])
  @@unique([repositoryId, pullRequestNumber, headSha])
}

model GitHubWebhookDelivery {
  id                String      @id
  event             String
  action            String
  repositoryFullName String
  pullRequestNumber Int
  headSha           String
  status            String      @default("processing")
  errorMessage      String?
  reviewId          String?
  review            CodeReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([reviewId])
}

model Finding {
  id            String    @id @default(cuid())
  reviewId      String
  review        CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file          String
  line          Int
  endLine       Int?
  title         String?
  message       String
  evidence      String?
  severity      String
  category      String          @default("quality")
  suggestions   String[]
  createdAt     DateTime  @default(now())

  @@index([reviewId])
}

model ChatConversation {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId      String       @unique
  review        CodeReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  title         String
  messages      ChatMessage[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([reviewId])
}

model ChatMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String
  createdAt      DateTime           @default(now())

  @@index([conversationId])
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model ReviewAnalytics {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId           String
  review             CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  totalIssues        Int
  bugs               Int
  securityIssues     Int
  performanceIssues  Int
  qualityScore       Int
  createdAt          DateTime   @default(now())

  @@index([userId])
  @@index([reviewId])
  @@unique([reviewId])
}
