# Backend .env
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_codeguard
REDIS_URL=redis://127.0.0.1:6380
# Leave unset when this process is reached directly. In production, set the exact number of trusted proxies. Do not use true.
# TRUST_PROXY_HOPS=1
# Optional. These can only lower a maximum or lengthen a window. See backend/README.md for every policy.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRY=7d
CSRF_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
AUTH_COOKIE_SAME_SITE=lax
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
# Set this temporarily to the previous key when rotating GITHUB_TOKEN_ENCRYPTION_KEY.
GITHUB_TOKEN_ENCRYPTION_KEY_PREVIOUS=
EMAIL_OTP_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-the-secret-configured-for-the-GitHub-webhook
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
# Optional dedicated isolated verification runner; use a random 32+ character token.
# FIX_VERIFICATION_RUNNER_URL=http://127.0.0.1:8080
# FIX_VERIFICATION_RUNNER_TOKEN=replace-with-a-random-runner-token-of-at-least-32-characters
# FIX_VERIFICATION_RUNNER_TIMEOUT_MS=300000
# FIX_VERIFICATION_STALE_AFTER_MS=900000
# FIX_VERIFICATION_MAX_DISPATCH_ATTEMPTS=3
# VERIFICATION_RUNNER_PORT=8080
# VERIFICATION_SANDBOX_MODE=disabled
# VERIFICATION_ALLOW_FETCH=false
# VERIFICATION_CALLBACK_URL=http://127.0.0.1:3001/api/reviews/internal/verification-callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/social/linkedin/callback
LINKEDIN_API_VERSION=202609
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRO_PRICE_ID=price_replace-with-your-test-price-id
STRIPE_API_VERSION=2023-10-16
# Required by the email worker. Use a Redis server supported by BullMQ (6.2+).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ai-codeguard.com
FRONTEND_URL=http://localhost:3000
