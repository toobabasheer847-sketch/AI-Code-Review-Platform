{
  "name": "ai-codeguard-backend",
  "version": "1.0.0",
  "description": "AI-CodeGuard - Production-level SaaS Code Review Platform Backend",
  "main": "dist/app/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc",
    "start": "node dist/app/server.js",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema src/prisma/schema.prisma",
    "seed": "tsx src/prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky install"
  },
  "dependencies": {
    "@langchain/openai": "^0.0.2",
    "@prisma/client": "^5.8.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.11",
    "morgan": "^1.10.0",
    "next": "^14.0.0",
    "nodemailer": "^6.9.0",
    "octokit": "^3.1.0",
    "openai": "^4.26.0",
    "pino": "^8.17.0",
    "pino-http": "^9.0.0",
    "redis": "^4.6.0",
    "socket.io": "^4.7.0",
    "stripe": "^14.10.0",
    "typescript": "^5.3.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^18.4.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "commitlint": "^18.4.0",
    "eslint": "^8.55.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^15.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.1.0",
    "prisma": "^5.8.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
