# AI-CodeGuard SaaS Platform
# Production-ready Code Review Platform with AI

## Frontend Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=AI-CodeGuard
VITE_STRIPE_PRO_PRICE_ID=price_pro_xxx_example

## Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_codeguard
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRY=7d
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-an-independent-random-secret-of-at-least-32-characters
# Set this temporarily to the previous key when rotating GITHUB_TOKEN_ENCRYPTION_KEY.
GITHUB_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# External Services
OPENAI_API_KEY=sk-your-openai-api-key
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ai-codeguard.com

# Application URLs
FRONTEND_URL=http://localhost:3000
